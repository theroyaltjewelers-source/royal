# ROYAL environment.  Copy the names into Render (Environment), never this
# file's values: every value here is a placeholder.  No real secret belongs
# in the repository.  See docs/ENVIRONMENT_MATRIX.md for what each one does.

# --- required in production ------------------------------------------------
ROYAL_ENV=production
XAI_API_KEY=xai-REPLACE_ME
ROYAL_GROK_MODEL=grok-4.3
ROYAL_OWNER_PASSCODE=REPLACE_WITH_10_OR_MORE_CHARACTERS
ROYAL_SESSION_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- optional --------------------------------------------------------------
# ROYAL_GROK_FAST_MODEL=
# ROYAL_VOICE=ara
# ROYAL_VOICE_MODEL=grok-voice-latest
# ROYAL_FLAGS={"realtime_voice":false}
# ROYAL_ALLOWED_ORIGINS=https://your-calculator.example
# ROYAL_TZ_OFFSET_MIN=-240
# ROYAL_SESSION_DAYS=30
# ROYAL_ACCESS_LOG=on
# DATABASE_SSL=true
# DATABASE_SSL_STRICT=false
# DATABASE_POOL_MAX=5
# ROYAL_AUTO_MIGRATE=true

# Calculator sign-in (Supabase), only if the calculator signs in to ROYAL:
# ROYAL_IDENTITY_URL=https://YOUR_PROJECT.supabase.co
# ROYAL_IDENTITY_ANON_KEY=REPLACE_ME
# ROYAL_OWNER_IDS=
# ROYAL_MEMBER_IDS=

# Grok Bots (webhooks Tahir sets up in each bot):
# GROKBOT_ENABLED=true
# GROKBOT_BOTS=skill_library,royal,ace,house,grace,me_bot,grok_bot
# GROKBOT_ACE_WEBHOOK_URL=https://REPLACE_ME
# GROKBOT_ACE_WEBHOOK_KEY=REPLACE_ME
# GROKBOT_ACE_KEY_HEADER=Authorization
# GROKBOT_ACE_REALMS=BUSINESS

# Contact research and email (paid, off by default):
# HUNTER_API_KEY=
# HUNTER_DAILY_LIMIT=25
# APOLLO_API_KEY=
# APOLLO_DAILY_LIMIT=25
# RESEND_API_KEY=
# ROYAL_EMAIL_FROM=

# Local development only; refused when ROYAL_ENV=production:
# ROYAL_DEV_OWNER_TOKEN=
# ROYAL_STORE_PATH=./royal-store.json
